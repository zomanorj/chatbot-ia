# Copy to .env. Values below match compose.yaml for local development.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mpanampy:mpanampy@localhost:5432/mpanampy
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# https://console.groq.com/keys
GROQ_API_KEY=
LLM_DEFAULT_MODEL=llama-3.3-70b-versatile
CHAT_RATE_LIMIT=20/minute

# Production only: IPs of the trusted reverse proxy, so rate limiting sees real client IPs.
# FORWARDED_ALLOW_IPS=*
