# Copy to .env. Values below match compose.yaml for local development.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mpanampy:mpanampy@localhost:5432/mpanampy
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# Signs access tokens. Generate with: openssl rand -hex 32 (required in production)
# SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Production with the API and dashboard on different sites: COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT=10/minute

# https://console.groq.com/keys
GROQ_API_KEY=
LLM_DEFAULT_MODEL=openai/gpt-oss-120b
CHAT_RATE_LIMIT=20/minute

# Production only: IPs of the trusted reverse proxy, so rate limiting sees real client IPs.
# FORWARDED_ALLOW_IPS=*
